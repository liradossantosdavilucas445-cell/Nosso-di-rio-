        // New DOM Elements
        const filterAllBtn = document.getElementById('filter-all');
        const filterMineBtn = document.getElementById('filter-mine');
        const entryDateInput = document.getElementById('entry-date');

        // Firestore paths - using public space so friends can see it
        const collectionName = 'diary_entries';
        const entriesRef = collection(db, 'artifacts', appId, 'public', 'data', collectionName);

        
        // Show non-blocking error message
        function showError(msg) {
            errorToast.textContent = msg;
            errorToast.classList.remove('hidden');
            setTimeout(() => {
                errorToast.classList.add('hidden');
            }, 5000);
        }

        // Auto-resize textarea
        entryInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
            if (this.value.trim() !== '') {
                sendBtn.classList.add('bg-indigo-600');
                sendBtn.classList.remove('bg-stone-400');
            } else {
                sendBtn.classList.add('bg-stone-400');
                sendBtn.classList.remove('bg-indigo-600');
            }
        });

        // Format Date nicely
        function formatTimestamp(timestamp) {
            if (!timestamp) return "Agora";
            const date = new Date(timestamp);
            const today = new Date();
            
            const isToday = date.getDate() === today.getDate() && 
                            date.getMonth() === today.getMonth() && 
                            date.getFullYear() === today.getFullYear();
            
            const timeOptions = { hour: '2-digit', minute: '2-digit' };
            const timeString = date.toLocaleTimeString('pt-BR', timeOptions);

            if (isToday) {
                return `Hoje às ${timeString}`;
            } else {
                return `${date.toLocaleDateString('pt-BR')} às ${timeString}`;
            }
        }

        // Format selected date (YYYY-MM-DD) to friendly format
        function formatEntryDate(dateString) {
            if (!dateString) return "Data desconhecida";
            const [year, month, day] = dateString.split('-');
            const dateObj = new Date(year, month - 1, day);
            const today = new Date();
            
            if (dateObj.getDate() === today.getDate() && 
                dateObj.getMonth() === today.getMonth() && 
                dateObj.getFullYear() === today.getFullYear()) {
                return "Hoje";
            }
            return `${day}/${month}/${year}`;
        }

        function renderFeed() {
            loadingIndicator.style.display = 'none';
            feed.innerHTML = ''; // Clear feed

            const filteredEntries = entries.filter(entry => {
                if (currentFilter === 'all') return true;
                return entry.userId === currentUser.uid;
            });

            if (filteredEntries.length === 0) {
                feed.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center p-6 text-stone-400 transition-opacity duration-500">
                        <span class="text-4xl mb-3 animate-bounce">🌱</span>
                        <p>${currentFilter === 'all' ? 'O diário está vazio.<br>Seja o primeiro a escrever!' : 'Você ainda não escreveu nada.<br>Como foi o seu dia?'}</p>
                    </div>
                `;
                return;
            }

            let lastDateStr = "";

            filteredEntries.forEach(entry => {
                const isMe = entry.userId === currentUser.uid;
                const entryDate = entry.selectedDate ? formatEntryDate(entry.selectedDate) : (entry.createdAt ? new Date(entry.createdAt).toLocaleDateString('pt-BR') : 'Hoje');
                
                // Date separator
                if (entryDate !== lastDateStr) {
                    const separator = document.createElement('div');
                    separator.className = 'text-center my-6 sticky top-2 z-10';
                    separator.innerHTML = `<span class="bg-[#fdfbf7]/80 backdrop-blur-md text-stone-500 text-[10px] font-bold px-4 py-1.5 rounded-full uppercase tracking-widest shadow-sm border border-stone-200">${entryDate}</span>`;
                    feed.appendChild(separator);
                    lastDateStr = entryDate;
                }

                // Entry Card
                const card = document.createElement('div');
                card.className = `flex flex-col mb-4 entry-enter ${isMe ? 'items-end' : 'items-start'}`;
                
                const bubbleColor = isMe ? 'bg-indigo-600 text-white rounded-br-none' : 'bg-white border border-stone-200 text-stone-800 rounded-bl-none shadow-sm';
                const authorDisplay = isMe ? 'Você' : (entry.author || 'Anônimo');
                
                // Convert line breaks to <br> tags
                const formattedText = entry.text.replace(/\n/g, '<br>');

                card.innerHTML = `
                    <div class="text-[11px] text-stone-500 mb-1 px-1 font-medium flex gap-2">
                        <span>${authorDisplay}</span>
                    </div>
                    <div class="max-w-[85%] px-4 py-3 rounded-2xl ${bubbleColor} shadow-sm leading-relaxed text-sm sm:text-base">
                        ${formattedText}
                    </div>
                    <div class="text-[10px] text-stone-400 mt-1 px-1">
                        ${formatTimestamp(entry.createdAt)}
                    </div>
                `;
                
                feed.appendChild(card);
            });

            // Scroll to bottom
            feed.scrollTo({
                top: feed.scrollHeight,
                behavior: 'smooth'
            });
        }

        function setupFirestoreListener() {
            if (!currentUser) return;

            // Fetch all entries, sort in memory per system prompt rules (No orderBy/limit)
            onSnapshot(entriesRef, (snapshot) => {
                const fetchedEntries = [];
                snapshot.forEach((doc) => {
                    const data = doc.data();
                    fetchedEntries.push({
                        id: doc.id,
                        ...data
                    });
                });

                // Sort by selectedDate, then by createdAt (time)
                entries = fetchedEntries.sort((a, b) => {
                    const dateA = a.selectedDate || (a.createdAt ? new Date(a.createdAt).toISOString().split('T')[0] : '1970-01-01');
                    const dateB = b.selectedDate || (b.createdAt ? new Date(b.createdAt).toISOString().split('T')[0] : '1970-01-01');
                    
                    if (dateA !== dateB) return dateA.localeCompare(dateB);
                    
                    const timeA = a.createdAt || 0;
                    const timeB = b.createdAt || 0;
                    return timeA - timeB;
                });

                renderFeed();
                onlineStatus.textContent = `Online • ${myNickname}`;
                onlineStatus.classList.add('text-green-600');
                
                // Enable inputs
                entryInput.disabled = false;
                sendBtn.disabled = false;

            }, (error) => {
                console.error("Erro ao sincronizar diário:", error);
                onlineStatus.textContent = "Desconectado";
                onlineStatus.classList.replace('text-green-600', 'text-red-500');
                showError("Não foi possível conectar ao diário.");
            });
        }

        
        // Handle sending new entry
        entryForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = entryInput.value.trim();
            const selectedDate = entryDateInput.value;
            
            if (!text || !currentUser || !myNickname) return;
            
            if (!selectedDate) {
                showError("Por favor, selecione a data do seu relato.");
                return;
            }

            // Optimistic UI clear
            entryInput.value = '';
            entryInput.style.height = 'auto';
            sendBtn.classList.replace('bg-indigo-600', 'bg-stone-400');
            
            try {
                await addDoc(entriesRef, {
                    text: text,
                    author: myNickname,
                    userId: currentUser.uid,
                    selectedDate: selectedDate,
                    createdAt: Date.now() // Used for exact time display
                });
            } catch (err) {
                console.error("Erro ao salvar entrada:", err);
                showError("Erro ao enviar mensagem. Tente novamente.");
                // Restore input
                entryInput.value = text;
            }
        });

        // Setup Filter Actions
        function updateFilters() {
            if (currentFilter === 'all') {
                filterAllBtn.className = "fluid-transition flex-1 py-1.5 rounded-lg bg-indigo-100 text-indigo-700 font-semibold text-sm border border-indigo-200 shadow-sm";
                filterMineBtn.className = "fluid-transition flex-1 py-1.5 rounded-lg bg-transparent text-stone-500 font-medium text-sm hover:bg-stone-100 border border-transparent";
            } else {
                filterMineBtn.className = "fluid-transition flex-1 py-1.5 rounded-lg bg-indigo-100 text-indigo-700 font-semibold text-sm border border-indigo-200 shadow-sm";
                filterAllBtn.className = "fluid-transition flex-1 py-1.5 rounded-lg bg-transparent text-stone-500 font-medium text-sm hover:bg-stone-100 border border-transparent";
            }
            renderFeed();
        }

        filterAllBtn.addEventListener('click', () => {
            currentFilter = 'all';
            updateFilters();
        });

        filterMineBtn.addEventListener('click', () => {
            currentFilter = 'mine';
            updateFilters();
        });

        // Set default date to today
        function initDateInput() {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            entryDateInput.value = `${year}-${month}-${day}`;
        }

        // Handle Setup Form (Setting Nickname)
        setupForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = nicknameInput.value.trim();
            if (name) {
